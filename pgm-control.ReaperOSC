# pgm-control.ReaperOSC
# PGM Reaper 控制端专用 OSC pattern 配置（基于 REAPER 7 官方 Default.ReaperOSC 精简）。
# 与项目 OSC_CONTRACT.md 的地址表保持一致；仅使用 REAPER 内置 OSC 控制面，
# 不依赖任何第三方 REAPER 扩展。

# 本控制面需要的轨道数 / region 数上限。注意：REAPER 会把列表填充到该容量
# （空 region 为空槽、空轨道为默认名 "Track N"）；桥接层在快照中过滤空 region。
DEVICE_TRACK_COUNT 64
DEVICE_SEND_COUNT 0
DEVICE_RECEIVE_COUNT 0
DEVICE_FX_COUNT 0
DEVICE_FX_PARAM_COUNT 0
DEVICE_FX_INST_PARAM_COUNT 0
DEVICE_MARKER_COUNT 0
DEVICE_REGION_COUNT 64

REAPER_TRACK_FOLLOWS REAPER
DEVICE_TRACK_FOLLOWS DEVICE
DEVICE_TRACK_BANK_FOLLOWS DEVICE
DEVICE_FX_FOLLOWS DEVICE

# 心跳与握手（桥接每 2s 发送一次，无副作用）：让「仅监听（接收）」模式下的
# REAPER 学到反馈回送地址（最后消息源）；重新确认 DEVICE_TRACK_FOLLOWS=DEVICE，
# 并声明设备容量，促使 REAPER 重发当前轨道/region 列表。
DEVICE_TRACK_FOLLOWS_DEVICE t/device/track/follows/device
DEVICE_TRACK_COUNT i/device/track/count t/device/track/count/@
DEVICE_REGION_COUNT i/device/region/count t/device/region/count/@

DEVICE_EQ INSERT
DEVICE_ROTARY_CENTER 0

# 走带时间码（秒）：桥接发送设置走带位置；REAPER 持续反馈当前位置。
TIME f/time

# 走带控制（trigger 型）。
STOP t/stop
PLAY t/play
PAUSE t/pause

# 全局 action：桥接启动时触发 41743「Control surface: Refresh all surfaces」，
# 让 REAPER 重发全量反馈（桥接重启后无需重加控制面即可恢复状态）。
ACTION i/action t/action/@

# 跳转到 region（桥接当前用 /time 跳转，保留此 pattern 备用）。
GOTO_REGION i/region t/region/@

# region 反馈（REAPER -> 桥接）：@ = REAPER region 编号（1 起）。
REGION_NAME s/region/@/name
REGION_TIME f/region/@/time
REGION_LENGTH f/region/@/length

# 轨道反馈与静音：@ = REAPER 轨道号（1 起，与 REAPER 界面一致）。
TRACK_NAME s/track/@/name
TRACK_MUTE b/track/@/mute
